# Copy to .env and edit. Every value is optional: with this file untouched (or
# absent) the app runs fully offline - mock OCR, fake LLM, in-memory vector store.
# Never commit real credentials.

# --- LLM: fake | openai | anthropic | groq --------------------------------------
# Real providers need LLM_MODEL, the provider's API key, and requirements-optional.txt.
LLM_PROVIDER=fake
LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- OCR: mock | tesseract ------------------------------------------------------
OCR_PROVIDER=mock

# --- RAG: memory | pinecone -----------------------------------------------------
# If VECTOR_STORE=pinecone but PINECONE_API_KEY is empty (or the pinecone package
# is missing), the app logs a warning and falls back to the in-memory store.
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX=doc-intel-reference
PINECONE_NAMESPACE=reference
# Only used when PINECONE_CREATE_INDEX=true and the index does not exist yet.
PINECONE_CREATE_INDEX=false
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# hashing | openai. The Pinecone index dimension must equal EMBEDDING_DIM.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=256
RAG_TOP_K=3

# --- Retry / review policy -------------------------------------------------------
# Hard caps (validated: MAX_RETRIES 0-5, MAX_STRUCTURING_ATTEMPTS 1-5).
MAX_RETRIES=2
MAX_STRUCTURING_ATTEMPTS=2
OCR_CONFIDENCE_THRESHOLD=0.80
APPROVAL_CONFIDENCE_THRESHOLD=0.75

# --- Runtime -----------------------------------------------------------------------
BATCH_MAX_CONCURRENCY=4
# Host port for `docker compose up` (container always listens on 8000).
API_PORT=8000
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# Where sample scans and RAG reference data live (defaults: data/sample_documents, data/reference).
# DOCUMENTS_DIR=
# REFERENCE_DIR=
