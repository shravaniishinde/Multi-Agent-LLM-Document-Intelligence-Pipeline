# Defaults run fully offline: mock OCR, fake LLM, in-memory vector store.

# fake | openai | anthropic | groq  (real providers also need LLM_MODEL + the provider's API key)
LLM_PROVIDER=fake
LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# mock | tesseract
OCR_PROVIDER=mock

# memory | pinecone
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX=doc-intel-reference
PINECONE_NAMESPACE=reference

# hashing | openai   (Pinecone index dimension must match: 256 for hashing)
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=256

# Retry / review policy
MAX_RETRIES=2
MAX_STRUCTURING_ATTEMPTS=2
OCR_CONFIDENCE_THRESHOLD=0.80
APPROVAL_CONFIDENCE_THRESHOLD=0.75
RAG_TOP_K=3
